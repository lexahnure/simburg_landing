<section class="hero-section" style="height:724px;background:#003E83;position:relative;overflow:hidden;padding-top:84px;box-sizing:border-box">
  <canvas ref="{{ heroCanvasRef }}" style="position:absolute;inset:0;width:100%;height:100%;display:block;cursor:pointer"></canvas>
  <div style="max-width:1240px;margin:0 auto;padding:0 24px;width:100%;height:100%;position:relative;display:flex;align-items:center;pointer-events:none">
    <div class="hero-text-wrap" style="max-width:560px;pointer-events:auto">
      <h1 class="hero-title" style="font-size:clamp(32px,4.6vw,52px);line-height:1.12;color:#FFFFFF;font-weight:700;margin:0 0 22px;letter-spacing:-0.025em">Standards-based software infrastructure for SIM and eSIM operations</h1>
      <p class="hero-desc" style="font-size:18px;line-height:1.6;color:#C6D2ED;margin:0 0 32px;max-width:520px">Simburg develops independent software platforms for remote SIM provisioning, smart card operating systems, and remote lifecycle management. Engineered strictly to open international standards.</p>
    </div>
  </div>
</section>

<section id="standards" class="standards-section" style="padding: 64px 24px 0; padding-top: 40px; background-color: #F8FAFC">
  <div ref="{{ refStandards }}" class="partners-bar" style="max-width: 1240px; margin: 0 auto; background: #FFFFFF; display: flex; align-items: center; justify-content: center; gap: 40px; flex-wrap: wrap; padding: 32px 48px; transition: opacity 0.7s ease,transform 0.7s ease; border-radius: 0px; padding-left: 40px; padding-right: 40px; padding-top: 20px; padding-bottom: 20px">
    <div class="partner-item" style="font-size:16px;font-weight:700;color:#1D2939;line-height:1.35;padding-right:40px;border-right:1px solid #E4E7EC">Delivered with leading<br>technology partners</div>
    <div class="partner-item" style="font-size:27px;font-weight:700;color:#8A8F98;letter-spacing:0.01em;font-family:Arial,Helvetica,sans-serif;padding-right:40px;border-right:1px solid #E4E7EC">SAMSUNG</div>
    <div class="partner-item" style="font-size:23px;font-weight:600;color:#8A8F98;font-style:italic;font-family:Georgia,serif">Infineon</div>
  </div>
</section>

<section id="products" class="products-section" style="padding: 56px 24px 110px; background-color: #FFFFFF; padding-bottom: 100px; padding-top: 100px">
  <div style="max-width: 1240px; margin: 0 auto">
    <div ref="{{ refProducts }}" class="products-card-wrap" style="border-radius: 32px; padding: 16px; transition: opacity 0.6s ease,transform 0.6s ease; position: static; background-color: #DCE9FA">
      
      <div class="products-header-wrap" style="margin-bottom: 44px; padding: 0 24px; width: calc(100% - 48px); padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; align-self: auto; max-width: 800px">
        <div style="font-size:13px;font-weight:700;color:#1D4ED8;letter-spacing:0.05em;margin-bottom:14px">PRODUCTS</div>
        <h2 class="products-section-title" style="font-size:38px;font-weight:800;color:#0F172A;margin:0 0 16px;letter-spacing:-0.02em">Solutions for the SIM and eSIM lifecycle</h2>
        <p style="font-size:17px;line-height:1.6;color:#334155;margin:0">Profile management, the card operating system, remote updates, and secure identity documents.</p>
      </div><div class="products-grid" style="display: grid; grid-template-columns: repeat(2,1fr); gap: 12px">

        <div class="product-item-card" style="box-sizing:border-box;border:1.5px solid transparent;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(#fff,#fff) border-box;border-radius: 24px; padding: 36px; display: flex; flex-direction: column; gap: 16px; padding-top: 24px; padding-right: 32px; padding-bottom: 24px; padding-left: 32px;transition:transform 0.3s ease" style-hover="transform:scale(1.02);background:linear-gradient(#fff,#fff) padding-box,conic-gradient(from var(--angle),#2C66DB,transparent 70%) border-box;animation:rotateBorder 2.5s linear infinite">
          <img src="uploads/RSP.svg" alt="" style="width: 60px; height: 60px">
          <div style="font-size:21px;font-weight:700;color:#0F172A;letter-spacing:-0.01em">RSP Solution</div>
          <p style="font-size:15px;line-height:1.6;color:#5A6472;margin:0;flex-grow:1">Launch consumer and IoT eSIM services without building profile management in-house.</p>
          <a href="product-rsp.dc.html" style="display:inline-flex;align-items:center;gap:6px;font-size:14.5px;font-weight:600;color:#0F172A;text-decoration:none;border:1.5px solid #D0D5DD;padding:10px 18px;border-radius:100px;width:fit-content;transition:background 0.2s ease,color 0.2s ease,border-color 0.2s ease" style-hover="background:#003E83;color:#FFFFFF;border-color:#003E83">Learn More<svg width="14" height="14" viewBox="0 0 24 24" fill="none" style-hover="animation:arrowSlide 1s ease infinite"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        </div>

        <div class="product-item-card" style="box-sizing:border-box;border:1.5px solid transparent;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(#fff,#fff) border-box;border-radius: 24px; padding: 36px; display: flex; flex-direction: column; gap: 16px; padding-top: 24px; padding-right: 32px; padding-bottom: 24px; padding-left: 32px;transition:transform 0.3s ease" style-hover="transform:scale(1.02);background:linear-gradient(#fff,#fff) padding-box,conic-gradient(from var(--angle),#2C66DB,transparent 70%) border-box;animation:rotateBorder 2.5s linear infinite">
          <img src="uploads/EDS.svg" alt="" style="width: 60px; height: 60px">
          <div style="font-size:21px;font-weight:700;color:#0F172A;letter-spacing:-0.01em">Electronic Documents Solution</div>
          <p style="font-size:15px;line-height:1.6;color:#5A6472;margin:0;flex-grow:1">Meet national-scheme security requirements for passports, licences, and vehicle registrations.</p>
          <a href="product-edoc.dc.html" style="display:inline-flex;align-items:center;gap:6px;font-size:14.5px;font-weight:600;color:#0F172A;text-decoration:none;border:1.5px solid #D0D5DD;padding:10px 18px;border-radius:100px;width:fit-content;transition:background 0.2s ease,color 0.2s ease,border-color 0.2s ease" style-hover="background:#003E83;color:#FFFFFF;border-color:#003E83">Learn More<svg width="14" height="14" viewBox="0 0 24 24" fill="none" style-hover="animation:arrowSlide 1s ease infinite"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        </div>

        <div class="product-item-card" style="background: #FFFFFF; border-radius: 24px; padding: 36px; display: flex; flex-direction: column; gap: 16px; padding-top: 24px; padding-right: 32px; padding-bottom: 24px; padding-left: 32px">
          <img src="uploads/ESIMOS.svg" alt="" style="width: 60px; height: 60px">
          <div style="font-size:21px;font-weight:700;color:#0F172A;letter-spacing:-0.01em">SIM/eSIM Operating System</div>
          <p style="font-size:15px;line-height:1.6;color:#5A6472;margin:0;flex-grow:1">One card OS across your fleet, from legacy SIM estates to next-generation eUICC.</p>
          <span style="display:inline-flex;align-items:center;gap:6px;font-size:14.5px;font-weight:600;color:#98A2B3;border:1.5px solid #E4E7EC;padding:10px 18px;border-radius:100px;width:fit-content">Coming Soon</span>
        </div>

        <div class="product-item-card" style="background: #FFFFFF; border-radius: 24px; padding: 36px; display: flex; flex-direction: column; gap: 16px; padding-top: 24px; padding-right: 32px; padding-bottom: 24px; padding-left: 32px">
          <img src="uploads/OTAPLATFORM.svg" alt="" style="width: 60px; height: 60px">
          <div style="font-size:21px;font-weight:700;color:#0F172A;letter-spacing:-0.01em">OTA Platform</div>
          <p style="font-size:15px;line-height:1.6;color:#5A6472;margin:0;flex-grow:1">Update and manage an entire installed base remotely, without truck rolls or card reissuance.</p>
          <span style="display:inline-flex;align-items:center;gap:6px;font-size:14.5px;font-weight:600;color:#98A2B3;border:1.5px solid #E4E7EC;padding:10px 18px;border-radius:100px;width:fit-content">Coming Soon</span>
        </div>

      </div>
    </div>
  </div>
</section>

<section class="benefits-section" style="padding: 128px 24px; border-top: 1px solid #F0F0F2; background-color: #F8FAFC; padding-top: 100px; padding-bottom: 100px">
  <div style="max-width: 1240px; margin: 0 auto">
    <div style="max-width: 640px; margin: 0 auto 64px; text-align: center; margin-bottom: 40px">
      <div style="font-size:14px;font-weight:600;color:#1C479C;margin-bottom:14px">Why Simburg</div>
      <h2 class="benefits-section-title" style="font-size:38px;font-weight:700;color:#14161A;margin:0;letter-spacing:-0.025em">Built on open standards,<br>not closed formats</h2>
    </div>
    <div ref="{{ refBenefits }}" class="benefits-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
      <div class="benefit-card" style="background:#FFFFFF;border-radius:20px;padding:32px;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%);position:relative;{{ benefitsStyle }};transition:opacity 0.6s ease,transform 0.6s ease;transition-delay:0ms">
        <div style="width: 48px; height: 48px; border-radius: 0%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px"><img src="uploads/lifecycle.svg" alt="" style="width: 48px; height: 48px"></div>
        <div style="font-size:17px;font-weight:700;color:#14161A;margin-bottom:10px;letter-spacing:-0.01em">Full profile-to-card lifecycle</div>
        <p style="font-size:14.5px;line-height:1.6;color:#5A5A63;margin:0">RSP, the SIM/eSIM operating system, and OTA management cover profile generation, the card runtime, and remote updates under one architecture.</p>
      </div>
      <div class="benefit-card" style="background:#FFFFFF;border-radius:20px;padding:32px;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%);position:relative;{{ benefitsStyle }};transition:opacity 0.6s ease,transform 0.6s ease;transition-delay:60ms">
        <div style="width: 48px; height: 48px; border-radius: 0%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px"><img src="uploads/oneplatform.svg" alt="" style="width: 48px; height: 48px"></div>
        <div style="font-size:17px;font-weight:700;color:#14161A;margin-bottom:10px;letter-spacing:-0.01em">Consumer and IoT, one platform</div>
        <p style="font-size:14.5px;line-height:1.6;color:#5A5A63;margin:0">Consumer eSIM under GSMA SGP.22 and headless IoT provisioning under SGP.31/SGP.32 run on the same RSP infrastructure.</p>
      </div>
      <div class="benefit-card" style="background:#FFFFFF;border-radius:20px;padding:32px;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%);position:relative;{{ benefitsStyle }};transition:opacity 0.6s ease,transform 0.6s ease;transition-delay:120ms">
        <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px"><img src="uploads/hsmkey.svg" alt="" style="width: 48px; height: 48px"></div>
        <div style="font-size:17px;font-weight:700;color:#14161A;margin-bottom:10px;letter-spacing:-0.01em">HSM-backed key security</div>
        <p style="font-size:14.5px;line-height:1.6;color:#5A5A63;margin:0">Profile protection keys and OTA cryptographic keysets (KIc/KID) are managed within an HSM, with counter-based replay protection and proof-of-receipt on every operation.</p>
      </div>
      <div class="benefit-card" style="background:#FFFFFF;border-radius:20px;padding:32px;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%);position:relative;{{ benefitsStyle }};transition:opacity 0.6s ease,transform 0.6s ease;transition-delay:180ms">
        <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px"><img src="uploads/otascale.svg" alt="" style="width: 48px; height: 48px"></div>
        <div style="font-size:17px;font-weight:700;color:#14161A;margin-bottom:10px;letter-spacing:-0.01em">Campaign-scale OTA operations</div>
        <p style="font-size:14.5px;line-height:1.6;color:#5A5A63;margin:0">Cohort targeting, scheduling, and throttling aligned to SMSC capacity, with automated retry policies and full APDU audit trails for large installed bases.</p>
      </div>
      <div class="benefit-card" style="background:#FFFFFF;border-radius:20px;padding:32px;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%);position:relative;{{ benefitsStyle }};transition:opacity 0.6s ease,transform 0.6s ease;transition-delay:240ms">
        <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px"><img src="uploads/universalcodebase.svg" alt="" style="width: 48px; height: 48px"></div>
        <div style="font-size:17px;font-weight:700;color:#14161A;margin-bottom:10px;letter-spacing:-0.01em">One codebase, SIM to eUICC</div>
        <p style="font-size:14.5px;line-height:1.6;color:#5A5A63;margin:0">The same native card OS codebase extends from classic SIM (3GPP Release 15, with Release 9 legacy support) into an ISD-R/ECASD eUICC architecture.</p>
      </div>
      <div class="benefit-card" style="background:#FFFFFF;border-radius:20px;padding:32px;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%);position:relative;{{ benefitsStyle }};transition:opacity 0.6s ease,transform 0.6s ease;transition-delay:300ms">
        <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px"><img src="uploads/standards.svg" alt="" style="width: 48px; height: 48px"></div>
        <div style="font-size:17px;font-weight:700;color:#14161A;margin-bottom:10px;letter-spacing:-0.01em">Standards over proprietary formats</div>
        <p style="font-size:14.5px;line-height:1.6;color:#5A5A63;margin:0">Every product is built against GSMA, ETSI, 3GPP, GlobalPlatform, and ICAO specifications, keeping integrations open and auditable rather than tied to a single vendor's format.</p>
      </div>
    </div>
  </div>
</section>

<section id="about" class="about-preview-section" style="padding: 128px 24px; background: #FFFFFF; padding-top: 100px; padding-bottom: 100px">
  <div ref="{{ refAbout }}" class="about-preview-grid" style="max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 5fr 3fr; gap: 0; align-items: center; transition: opacity 0.7s ease,transform 0.7s ease">
    <div class="about-preview-text" style="display: flex; flex-direction: column; gap: 24px">
      <h3 style="font-size: 28px; font-weight: 700; color: #1C479C; margin: 0 0 20px; line-height: 1.25; margin-bottom: 0px">Simburg</h3>
      <p style="font-size: 28px; line-height: 1.25; color: #1C479C; margin: 0 0 24px; font-weight: 500; margin-bottom: 0px">We develop standalone software components for telecommunications and secure digital identity. Our engineering approach prioritizes full compliance with international standards, enabling network operators, IoT providers, and card manufacturers to deploy specialized services without building from scratch.</p>
      <a href="about.dc.html" style="display:inline-flex;align-items:center;gap:8px;background:transparent;color:#003E83;text-decoration:none;font-size:16px;font-weight:700;padding:14px 30px;border-radius:100px;width:fit-content;margin-top:8px;border:1.5px solid #003E83;transition:background 0.2s ease,color 0.2s ease" style-hover="background:#003E83;color:#FFFFFF">Get know more</a>
    </div>
    <div class="about-preview-image" style="display:flex;align-items:center;justify-content:center">
      <img src="uploads/hexa_about.png" alt="" style="width: 110%; height: 100%">
    </div>
  </div>
</section>


<section class="cta-banner-section" style="padding:0 24px 100px;background:#FFFFFF">
  <div ref="{{ refContact }}" class="cta-banner-container" style="max-width: 1240px; margin: 0 auto; background: #EFF6FF; border-radius: 40px; position: relative; overflow: hidden; display: flex; align-items: center; min-height: 300px; transition: opacity 0.7s ease,transform 0.7s ease">
